<!--
  Detection : RDP Brute Force (Windows)
  Lab       : soc-home-lab (Wazuh 4.9.2, Win10 Target + Sysmon)
  Install   : /var/ossec/etc/rules/rdp-brute-force.xml
              then: systemctl restart wazuh-manager
  Rule IDs  : 100100 - 100102 (custom range 100000+)

  Description:
    100100  Base rule. Single failed logon, Event ID 4625, LogonType 10
            (RemoteInteractive, i.e. RDP). Parent: built-in rule 60122
            (Logon failure - unknown user or bad password).
    100101  Correlation. 8 or more rule 100100 events from the same source IP
            within 120 seconds. Level 10.
    100102  Escalation. Successful logon (Event ID 4624, LogonType 10) from the
            same source IP shortly after rule 100101. Possible compromise.

  MITRE ATT&CK:
    T1110      Brute Force
    T1021.001  Remote Services: Remote Desktop Protocol
    T1078      Valid Accounts (only for rule 100102)

  Notes:
    - same_source_ip relies on the decoded srcip field. For Windows
      eventchannel events the source address lives in
      win.eventdata.ipAddress, so same_field is used here for reliability.
    - With NLA (Network Level Authentication) enabled, failed RDP logons are
      often logged with LogonType 3 instead of 10. If rule 100100 never fires,
      check the logonType in the raw event and, if needed, change the regex to
      ^(3|10)$ (this widens the scope to network logons).

  Investigation: ../investigations/rdp-brute-force.md
-->
<group name="windows,rdp,authentication_failures,custom,">

  <!-- 100100: single failed RDP logon -->
  <rule id="100100" level="5">
    <if_sid>60122</if_sid>
    <field name="win.system.eventID">^4625$</field>
    <field name="win.eventdata.logonType">^10$</field>
    <description>RDP: failed logon (Event 4625, LogonType 10) from $(win.eventdata.ipAddress) for user $(win.eventdata.targetUserName).</description>
    <mitre>
      <id>T1110</id>
      <id>T1021.001</id>
    </mitre>
    <group>rdp_failed_logon,</group>
  </rule>

  <!-- 100101: brute force, 8 failures in 120 seconds from one source -->
  <rule id="100101" level="10" frequency="8" timeframe="120">
    <if_matched_sid>100100</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>RDP brute force: 8 or more failed logons within 120 seconds from $(win.eventdata.ipAddress).</description>
    <mitre>
      <id>T1110</id>
      <id>T1021.001</id>
    </mitre>
    <group>rdp_brute_force,attack,</group>
  </rule>

  <!-- 100102: successful RDP logon after a brute force burst -->
  <rule id="100102" level="12" frequency="2" timeframe="600">
    <if_matched_sid>100101</if_matched_sid>
    <if_sid>60106</if_sid>
    <field name="win.system.eventID">^4624$</field>
    <field name="win.eventdata.logonType">^10$</field>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>RDP: successful logon from $(win.eventdata.ipAddress) after brute force activity. Possible account compromise.</description>
    <mitre>
      <id>T1110</id>
      <id>T1021.001</id>
      <id>T1078</id>
    </mitre>
    <group>rdp_brute_force,rdp_success_after_bruteforce,attack,</group>
  </rule>

</group>
